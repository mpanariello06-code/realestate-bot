# ============================================================
#  Real Estate Bot – Environment Variables
#  Fill in the values below and you're ready to go.
#  No need to rename this file – it is already named .env
# ============================================================

# ── Telegram ─────────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram chat IDs that are allowed
# to use the agent commands (e.g. 123456789,987654321)
AGENT_CHAT_IDS=your_agent_chat_id_here

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Model to use for lead qualification (e.g. gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o

# ── Google Sheets ────────────────────────────────────────────
# Path to your Google service-account JSON file
GOOGLE_CREDENTIALS_FILE=google_credentials.json
# Name of the Google Spreadsheet to use
GOOGLE_SPREADSHEET_NAME=RealEstate Bot Leads

# ── Facebook / Instagram ─────────────────────────────────────
# Long-lived page access token from Facebook Developers
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
# Facebook Page ID
FACEBOOK_PAGE_ID=your_facebook_page_id_here
# Instagram Business Account ID (found in Facebook Business Manager)
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# ── TikTok ───────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_OPEN_ID=your_tiktok_open_id_here

# ── Flask Web Portal ─────────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_random_secret_string
FLASK_PORT=5000
# Set to "production" in prod
FLASK_ENV=development

# ── Lead Qualification Settings ──────────────────────────────
# Minimum score (0-100) for a lead to be considered "qualified"
LEAD_QUALIFICATION_THRESHOLD=60

# ── Weekly Report ────────────────────────────────────────────
# Day of the week for the weekly report: mon, tue, wed, thu, fri, sat, sun
WEEKLY_REPORT_DAY=mon
# Time in HH:MM (24h) format – UTC
WEEKLY_REPORT_TIME=08:00
