# ============================================================
#  Real Estate Bot – Environment Variables
#  Fill in the values below and you're ready to go.
#  No need to rename this file – it is already named .env
# ============================================================

# ── Telegram ─────────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram chat IDs that are allowed
# to use the agent commands (e.g. 123456789,987654321)
AGENT_CHAT_IDS=your_agent_chat_id_here

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Model to use for lead qualification (e.g. gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o

# ── Google Sheets ────────────────────────────────────────────
# Path to your Google service-account JSON file
GOOGLE_CREDENTIALS_FILE=google_credentials.json
# Name of the Google Spreadsheet to use
GOOGLE_SPREADSHEET_NAME=RealEstate Bot Leads

# ── Zapier (RECOMMENDED for Facebook & Instagram posting) ────────────────────
# Zapier lets you post to Facebook and Instagram without needing a direct
# API connection.  The bot sends every "Post Listing" action to your Zapier
# "Catch Hook" webhook URL.  Zapier then publishes the post automatically.
#
# STEP-BY-STEP SETUP
# ──────────────────
# 1. Log in to zapier.com and click "Create Zap".
# 2. Set the Trigger:
#      App:    Webhooks by Zapier
#      Event:  Catch Hook
#      Click "Continue" – Zapier will generate a unique webhook URL.
#      Copy that URL.
# 3. Add your posting Action(s):
#      Action 1: Facebook Pages → Create Page Post
#                Map the 'caption' field from the webhook to the Message.
#      Action 2: Instagram for Business → Create Photo Post
#                Map the 'caption' field to the Caption.
#                Map the 'image' file field to the Photo URL / Media.
# 4. Turn on the Zap.
# 5. Paste the webhook URL below:
ZAPIER_WEBHOOK_URL=

# ── Cloudinary (required for photo uploads with Zapier) ──────────────────────
# Cloudinary stores the listing photo and gives back a public URL that Zapier
# (and Instagram / Facebook) can download when publishing your post.
#
# STEP-BY-STEP SETUP
# ──────────────────
# 1. Create a FREE account at https://cloudinary.com
# 2. After signing in, go to your Dashboard (top-left cloud icon).
# 3. Under "Product Environment Credentials" you will see:
#      Cloud name – copy it below as CLOUDINARY_CLOUD_NAME
#      API Key    – copy it below as CLOUDINARY_API_KEY
#      API Secret – click "reveal" and copy it as CLOUDINARY_API_SECRET
# 4. Paste all three values below.
#
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── Facebook / Instagram ─────────────────────────────────────
# NOTE: Direct Facebook/Instagram credentials are only needed if you are
# NOT using Zapier.  When ZAPIER_WEBHOOK_URL is set, these are ignored for
# social posting (they are still used by the direct Graph API fallback path).
#
# How to get these values:
#   1. Go to developers.facebook.com → My Apps → your app
#   2. Add "Pages" product and generate a long-lived Page Access Token
#   3. Your Page ID is shown in your Facebook Page → About → Page ID
#   4. Your Instagram Account ID is in Facebook Business Manager →
#      Instagram Accounts → the numeric ID next to your IG account
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# ── Facebook Webhook (for comment / DM notifications) ────────
# These are used when Facebook sends events to this bot directly.
# If you are routing everything through GHL you can leave these blank.
#
# FACEBOOK_WEBHOOK_VERIFY_TOKEN – any secret string you choose.
#   Copy it into the Facebook App Dashboard → Webhooks → Verify Token.
# FACEBOOK_APP_SECRET – found in App → Settings → Basic → App Secret.
#   Used to validate the X-Hub-Signature-256 header on inbound payloads.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_facebook_webhook_verify_token_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# ── Go High Level (GHL) ──────────────────────────────────────
# GHL is the RECOMMENDED way to connect Facebook and Instagram.
# It lets you publish posts through GHL's Social Planner and
# automatically DM anyone who replies to a post.
#
# STEP-BY-STEP SETUP
# ──────────────────
# 1. Log in to your GHL sub-account.
# 2. Get your Private Integration API Key:
#      Settings → Integrations → Private Integrations → Create
#      Copy the key and paste it as GHL_API_KEY below.
# 3. Get your Location ID (sub-account ID):
#      Settings → Business Profile → scroll to "Location ID"
#      Copy it and paste it as GHL_LOCATION_ID below.
# 4. Connect Facebook & Instagram inside GHL:
#      Settings → Integrations → Social Media → Connect Facebook
#      Authorise your Facebook Page and Instagram Business Account.
# 5. Register the bot webhook in GHL:
#      Settings → Webhooks → Add New Webhook
#      URL:   https://<your-server-domain>/webhook/ghl
#      Event: InboundMessage
#      (Optional) Set a signing secret and paste it as GHL_WEBHOOK_SECRET.
# 6. Run the bot and type /ghl in Telegram to confirm the connection.
#
# GHL API base URL: https://services.leadconnectorhq.com
GHL_API_KEY=your_ghl_private_integration_key_here
GHL_LOCATION_ID=your_ghl_location_id_here

# Optional: HMAC-SHA256 secret for validating inbound GHL webhook payloads.
# Generate any random string, paste it here AND in GHL webhook settings.
GHL_WEBHOOK_SECRET=your_ghl_webhook_secret_here

# Auto-DM reply settings
# When GHL_AUTO_REPLY_ENABLED=true the bot will DM every person who
# replies to one of your GHL Social Planner posts.
# Use {first_name}, {last_name}, or {full_name} as placeholders.
GHL_AUTO_REPLY_ENABLED=true
GHL_AUTO_REPLY_MESSAGE=Hi {first_name}! 👋 Thanks for your interest in our property. One of our agents will be in touch with you shortly. Feel free to ask any questions!

# GHL Social Planner – which accounts to post to when you hit "Post Listing"
# Leave blank to automatically post to ALL connected Facebook and Instagram
# accounts for this GHL location (recommended).
# To target specific accounts only, prefix each ID with the platform type:
#   fb:<accountId>  – for a Facebook Page account
#   ig:<accountId>  – for an Instagram Business account
# Separate multiple accounts with commas.
# Example: GHL_SOCIAL_ACCOUNT_IDS=fb:abc123,ig:def456
GHL_SOCIAL_ACCOUNT_IDS=

# ── GHL OAuth2 Token Refresh (optional but recommended) ──────────────────────
# GHL Private Integration access tokens expire after ~24 hours and must be
# refreshed.  Set these three values to enable automatic silent refresh so
# the bot never shows a "401 Unauthorized" error to agents.
#
# Where to get these values:
#   1. In GHL, go to Settings → Integrations → Private Integrations.
#   2. Open your integration and complete the OAuth2 "Authorization Code" flow.
#   3. The authorization server returns access_token, refresh_token,
#      client_id and client_secret.  Paste them below.
#
# If you leave these blank the bot will still work, but you will need to
# manually regenerate GHL_API_KEY every time it expires.
GHL_CLIENT_ID=your_ghl_client_id_here
GHL_CLIENT_SECRET=your_ghl_client_secret_here
GHL_REFRESH_TOKEN=your_ghl_refresh_token_here

# ── Flask Web Portal ─────────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_random_secret_string
FLASK_PORT=5000
# Set to "production" in prod
FLASK_ENV=development

# ── Lead Qualification Settings ──────────────────────────────
# Minimum score (0-100) for a lead to be considered "qualified"
LEAD_QUALIFICATION_THRESHOLD=60

# ── Weekly Report ────────────────────────────────────────────
# Day of the week for the weekly report: mon, tue, wed, thu, fri, sat, sun
WEEKLY_REPORT_DAY=mon
# Time in HH:MM (24h) format – UTC
WEEKLY_REPORT_TIME=08:00
