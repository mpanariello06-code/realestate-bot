{
  "name": "realestate-bot-desktop",
  "version": "1.0.0",
  "description": "Real Estate Agent Automation Platform",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "build:all": "electron-builder build -mwl"
  },
  "build": {
    "appId": "com.realestate.bot",
    "productName": "RealEstate Bot",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "**/*",
      "!node_modules/.cache"
    ]
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "electron-store": "^8.2.0"
  }
}
